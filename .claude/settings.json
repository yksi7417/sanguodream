{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.CLAUDE_PROJECT_DIR || '.', '.claude', 'hooks', 'wall.js'))\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
